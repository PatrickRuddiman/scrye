# Copy to smoke-test/config.env and edit. Every variable has a default;
# only override what you need. The orchestrator (`run.sh`) sources this
# file if it exists; individual scripts inherit the resulting env.

# --- Azure ---------------------------------------------------------------
# Resource group + region for the smoke VM. Group is created on first run
# and torn down by `cleanup.sh`. Pick a region you have Standard_B2ms quota
# in.
SCRYD_SMOKE_RG="scryd-smoke"
SCRYD_SMOKE_LOCATION="eastus2"
SCRYD_SMOKE_VM_NAME="scryd-smoke-vm"
SCRYD_SMOKE_VM_SIZE="Standard_B4ms"   # 4 vCPU / 16 GiB; cargo link of scryd peaks ~5 GiB, no swap on default image
SCRYD_SMOKE_VM_IMAGE="Ubuntu2204"     # az vm image alias; resolves to canonical/0001-com-ubuntu-server-jammy:22_04-lts-gen2
SCRYD_SMOKE_VM_USER="azureuser"

# --- IMAP account under test --------------------------------------------
# The address and host the smoke run drives into scryd via `add-account`.
# Password is never committed. For unattended local runs, put it in
# smoke-test/.state/secrets.env (gitignored, chmod 0600 on load), or
# export SCRYD_SMOKE_IMAP_PASSWORD in the environment. `04_account.sh`
# pipes it over SSH into `scryd add-account --password-stdin`.
SCRYD_SMOKE_ACCOUNT_ID="junk"
SCRYD_SMOKE_IMAP_USER="junk@pjly.io"
SCRYD_SMOKE_IMAP_HOST="mail.pjly.io"
SCRYD_SMOKE_IMAP_PORT="993"
SCRYD_SMOKE_IMAP_FOLDERS="INBOX"

# --- GitHub bug filing --------------------------------------------------
# Findings discovered by `05_smoke.sh` get filed as issues by `06_bugs.sh`.
# Dedup is by exact title under the smoke-test label, scoped to this repo.
SCRYD_SMOKE_GH_REPO="PatrickRuddiman/scrye"
SCRYD_SMOKE_GH_LABEL="smoke-test"
